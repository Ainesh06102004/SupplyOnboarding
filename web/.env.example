# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for marketplace SKU-map and zone lookups, and for web/scripts/*.
# Without it every product reports `unknown` availability.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
# Supabase Auth needs no extra env vars here — the two NEXT_PUBLIC_SUPABASE_*
# values above are the whole client configuration. Sign-in providers are
# switched on in the Supabase dashboard, not in this file.
#
# SHOPPERS: phone + OTP, the primary and default front door.
#
#   Authentication → Sign In / Providers → Phone
#     • Enable "Phone", then pick an SMS provider. KOI uses Twilio.
#     • Supabase ships NO SMS of its own — every code is a paid message.
#     • Twilio needs: Account SID, Auth Token, Message Service SID.
#       (Twilio Verify is a DIFFERENT dashboard option and takes a Verify
#       Service SID instead. Either works; the app code is the same.)
#     • For Indian numbers the Twilio sender and templates must be registered
#       under TRAI DLT. Without it the API accepts the send and the SMS is
#       never delivered — which looks exactly like a mistyped number.
#
# SHOPPERS: Google, optional and OFF unless this is "true".
#
#   The code path is built and working, but the button is hidden until this is
#   set, because it cannot function until the Google Cloud OAuth client exists
#   and a button that always fails is worse than no button.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=
#
#   Authentication → Sign In / Providers → Google
#     • Client ID and Secret come from a Google Cloud OAuth 2.0 Web client.
#     • That Google client's "Authorised redirect URI" must be
#       https://<project-ref>.supabase.co/auth/v1/callback
#
# BOTH, and easy to forget:
#
#   Authentication → URL Configuration
#     • Site URL: the deployed origin (e.g. https://www.koinorth.com)
#     • Redirect URLs must include http://localhost:3000/auth/callback for dev
#   Only the Google flow round-trips through /auth/callback; phone OTP verifies
#   in place and needs no redirect allowlisting.
#
# SUPPLIERS: email and password, behind /login. Enabled already; nothing to do.


# ── Marketplace ─────────────────────────────────────────────────────────────
# null (default, honest) | mock | swiggy
KOI_MARKETPLACE=null

# AES-256-GCM key for provider tokens at rest. 64 hex chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it no per-user Swiggy connection can be stored or read.
KOI_CREDENTIAL_KEY=

# ── Swiggy Instamart MCP ────────────────────────────────────────────────────
# Defaults to https://mcp.swiggy.com/im. Point at staging while testing.
SWIGGY_MCP_URL=
# The house credential for LOGGED-OUT browse. search_products requires an
# addressId and addresses are per-authenticated-user, so without these a
# signed-out shopper sees `unknown` for everything — which is honest.
# Whether KOI may operate a house account is an OPEN QUESTION with Swiggy.
SWIGGY_HOUSE_ACCESS_TOKEN=
SWIGGY_HOUSE_ADDRESS_ID=

# ── Mock knobs (dev only; ignored unless KOI_MARKETPLACE=mock) ──────────────
# The mock hashes availability per 30s TTL window, so its adversarial states
# are otherwise only reachable by waiting for the right window. 0..1.
KOI_MOCK_OUT_OF_STOCK_RATE=
KOI_MOCK_UNKNOWN_RATE=
KOI_MOCK_ERROR_RATE=
