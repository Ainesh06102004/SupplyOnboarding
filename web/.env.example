# ============================================================================
# KOI — environment
# Copy to `.env.local` and fill in. `.env*` is gitignored; never commit real
# values. The anon key is browser-visible by design, so it is NOT a secret —
# but it is only safe once RLS is enabled on every table. It is not, yet.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-visible key. Bounded only by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, never
# import into a client component. Route handlers and scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase (auth) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Marketplace supply ──────────────────────────────────────────────────────
# Which supply adapter backs live availability and fulfilment.
#   null   — no supply source. Every product reports availability 'unknown'.
#            This is the honest default and the correct production value today.
#   mock   — deterministic local fixtures for development.
#   swiggy — Swiggy Instamart over MCP. Requires credentials KOI does not have.
KOI_MARKETPLACE=null
