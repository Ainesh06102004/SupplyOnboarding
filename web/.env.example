# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for marketplace SKU-map and zone lookups, and for web/scripts/*.
# Without it every product reports `unknown` availability.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
# Supabase Auth needs no extra env vars here — the two NEXT_PUBLIC_SUPABASE_*
# values above are the whole client configuration. Sign-in providers are
# switched on in the Supabase dashboard, not in this file.
#
# SHOPPERS: phone + OTP, the primary and default front door.
#
#   Authentication → Sign In / Providers → Phone
#     • Enable "Phone", then pick an SMS provider. KOI uses Twilio.
#     • Supabase ships NO SMS of its own — every code is a paid message.
#     • Twilio needs: Account SID, Auth Token, Message Service SID.
#       (Twilio Verify is a DIFFERENT dashboard option and takes a Verify
#       Service SID instead. Either works; the app code is the same.)
#     • For Indian numbers the Twilio sender and templates must be registered
#       under TRAI DLT. Without it the API accepts the send and the SMS is
#       never delivered — which looks exactly like a mistyped number.
#
# SHOPPERS: Google, optional and OFF unless this is "true".
#
#   The code path is built and working, but the button is hidden until this is
#   set, because it cannot function until the Google Cloud OAuth client exists
#   and a button that always fails is worse than no button.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=
#
#   Authentication → Sign In / Providers → Google
#     • Client ID and Secret come from a Google Cloud OAuth 2.0 Web client.
#     • That Google client's "Authorised redirect URI" must be
#       https://<project-ref>.supabase.co/auth/v1/callback
#
# BOTH, and easy to forget:
#
#   Authentication → URL Configuration
#     • Site URL: the deployed origin (e.g. https://www.koinorth.com)
#     • Redirect URLs must include http://localhost:3000/auth/callback for dev
#   Only the Google flow round-trips through /auth/callback; phone OTP verifies
#   in place and needs no redirect allowlisting.
#
# SUPPLIERS: email and password, behind /login. Enabled already; nothing to do.


# ── Marketplace ─────────────────────────────────────────────────────────────
# null (default, honest) | mock | swiggy
KOI_MARKETPLACE=null

# AES-256-GCM key for provider tokens at rest. 64 hex chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it no per-user Swiggy connection can be stored or read.
KOI_CREDENTIAL_KEY=

# ── Swiggy Instamart MCP ────────────────────────────────────────────────────
# Defaults to https://mcp.swiggy.com/im. Point at staging while testing.
SWIGGY_MCP_URL=
# The house credential for LOGGED-OUT browse. search_products requires an
# addressId and addresses are per-authenticated-user, so without these a
# signed-out shopper sees `unknown` for everything — which is honest.
# Whether KOI may operate a house account is an OPEN QUESTION with Swiggy.
SWIGGY_HOUSE_ACCESS_TOKEN=
SWIGGY_HOUSE_ADDRESS_ID=

# ── Connecting a shopper's own Swiggy account (OAuth 2.1 + PKCE) ────────────
# This is the path that matters: update_cart writes to the cart the shopper
# checks out and pays from, which is on THEIR account. A house credential can
# power browsing but can never complete an order.
#
# Without SWIGGY_CLIENT_ID the Connect button does not render at all — a
# control that cannot work is worse than none.
SWIGGY_CLIENT_ID=
# Optional. A public client relies on PKCE alone; set this only if Swiggy
# issues a confidential client, in which case the token endpoint is called
# with HTTP Basic auth.
SWIGGY_CLIENT_SECRET=
# Both default to the SWIGGY_MCP_URL origin + /auth/authorize and /auth/token,
# which the published docs confirm are correct for production. Override for
# staging, which lives on mcp-staging.swiggy.com.
SWIGGY_OAUTH_AUTHORIZE_URL=
SWIGGY_OAUTH_TOKEN_URL=
#
# Swiggy matches the redirect URI EXACTLY. In development it is derived from the
# request origin, so localhost on any port just works and there is nothing to
# set. In production it must be pinned, because a host that hands out a URL per
# build — a Vercel preview, for instance — produces a different URI on every
# push and none of them will match what is registered.
#
# Origin only, no trailing slash, no path. Leave EMPTY in development.
KOI_PUBLIC_ORIGIN=
#
# Whatever this resolves to is what Swiggy's client registration must allow,
# character for character:
#   http://localhost:3000/api/marketplace/connect/swiggy/callback   (dev)
#   https://<KOI_PUBLIC_ORIGIN>/api/marketplace/connect/swiggy/callback  (prod)

# ── AI (server only) ────────────────────────────────────────────────────────
# Read only by server code under lib/ai/. Never prefix it NEXT_PUBLIC_: that
# would ship the key to every browser. What a model is sent is fixed by design:
# the shopper's sentence or a pack photo, never a profile, an order, or anything
# that came from Swiggy. Empty is fine — every AI path has a deterministic
# fallback and the store works without a model.
OPENAI_API_KEY=
# The model that reads pack photos for the label engine (/staff/review). A
# vision-capable OpenAI model id from your account. Required — the engine
# refuses to run without it rather than guessing a model.
KOI_LABEL_MODEL=
# Optional second model for the independent check reading. A different model
# catches misreadings the first would repeat; empty means the same model reads
# twice.
KOI_LABEL_VERIFIER_MODEL=
# Guards /api/engine/run, the scheduled label reader (web/vercel.json). Vercel
# Cron sends it automatically; the route is off while this is empty.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Which interpreter refines ⌘K queries. none (default) | openai (not built yet).
# An unknown or empty value quietly resolves to none.
KOI_AI_INTERPRETER=

# ── Mock knobs (dev only; ignored unless KOI_MARKETPLACE=mock) ──────────────
# The mock hashes availability per 30s TTL window, so its adversarial states
# are otherwise only reachable by waiting for the right window. 0..1.
KOI_MOCK_OUT_OF_STOCK_RATE=
KOI_MOCK_UNKNOWN_RATE=
KOI_MOCK_ERROR_RATE=
